# --- QRS connection (standalone — independent of the qlik_lineage repo) ----
# Same /custom virtual-proxy header-auth style used elsewhere in this org.
QRS_BASE_URL=https://10.221.11.6/custom
QRS_XRF_KEY=1234567890abcdef
QRS_USER=CORPORATE\srv-qlik
QRS_VERIFY_SSL=false
QRS_TIMEOUT_SECONDS=30

# --- Inactivity rule ---------------------------------------------------------
# Which signal marks a user "inactive"? Pick ONE strategy and fill in its
# settings. Run `python cleanup.py --inspect` first against a real QMC to see
# what fields/custom properties actually exist on your users before choosing.
#
#   inactive        : QRS's native inactive=true boolean field
#   custom_property : a Custom Property (tag-like key/value) on the user,
#                     e.g. Inactive = true
#   blacklisted     : QRS's own `blacklisted` boolean field on /qrs/user
#   external_audit  : an external CSV export of last-login dates; users not
#                     seen in N days are considered inactive
INACTIVITY_STRATEGY=inactive

# Used when INACTIVITY_STRATEGY=custom_property
INACTIVE_CUSTOM_PROPERTY_NAME=Inactive
INACTIVE_CUSTOM_PROPERTY_VALUE=true

# Used when INACTIVITY_STRATEGY=external_audit
INACTIVE_AUDIT_CSV_PATH=
INACTIVE_AUDIT_DAYS_THRESHOLD=90

# --- Safety -------------------------------------------------------------------
# Comma-separated userIds or userDirectory\userId pairs that must NEVER be
# deleted even if flagged inactive (service accounts, admins, etc.)
PROTECTED_USERS=CORPORATE\srv-qlik,CORPORATE\admin

# Where dry-run/delete reports get written
REPORTS_DIR=reports
